{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://yxnharness.dev/schema/runner-adapter.schema.json",
  "title": "YXNHarness runner adapter declaration",
  "description": "Declares a platform runner that can start a target UI and speak the language-neutral harness control contract. status=ready means the CLI can actually run it; planned adapters must not be offered as attachable.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "displayName", "status", "platforms", "languages", "transport", "controlBinding"],
  "properties": {
    "version": { "const": 1 },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
    "status": { "type": "string", "enum": ["ready", "planned"] },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["web", "macos", "ios", "android", "desktop", "mobile", "embedded"]
      }
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1, "maxLength": 40 }
    },
    "transport": {
      "type": "string",
      "enum": ["in-page", "json-rpc-local", "stdio", "websocket-loopback"]
    },
    "controlBinding": {
      "type": "string",
      "description": "How the semantic control contract is exposed in this runtime (e.g. window.__harness, HarnessControlling protocol).",
      "minLength": 1,
      "maxLength": 200
    },
    "docs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "exampleAdapter": { "type": "string", "minLength": 1, "maxLength": 200 },
    "note": { "type": "string", "maxLength": 500 }
  }
}
