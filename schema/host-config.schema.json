{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://yxnharness.dev/schema/host-config.schema.json",
  "title": "YXNHarness host cockpit config",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "host", "defaults", "consent", "access", "moderation"],
  "properties": {
    "version": { "const": 1 },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "projectLabel": { "type": "string", "minLength": 1, "maxLength": 120 }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["viewports", "scenarioOut"],
      "properties": {
        "viewports": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "width", "height"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "width": { "type": "integer", "minimum": 1, "maximum": 4096 },
              "height": { "type": "integer", "minimum": 1, "maximum": 4096 }
            }
          }
        },
        "scenarioOut": { "type": "string", "minLength": 1, "maxLength": 260 }
      }
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["browserInstallPolicy", "requireExplicitYes"],
      "properties": {
        "browserInstallPolicy": {
          "type": "string",
          "enum": ["ask-every-time", "ask-once-per-machine", "deny"]
        },
        "requireExplicitYes": { "type": "boolean" }
      }
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visibility", "shareLinkGrant", "mergeAuthority"],
      "properties": {
        "visibility": { "type": "string", "enum": ["private", "restricted", "public"] },
        "shareLinkGrant": { "type": "string", "enum": ["none", "view", "comment"] },
        "mergeAuthority": { "type": "string", "enum": ["host"] }
      }
    },
    "moderation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requireReviewedExpects", "allowForceOverwrite"],
      "properties": {
        "requireReviewedExpects": { "type": "boolean" },
        "allowForceOverwrite": { "type": "boolean" }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional connected agent adapter. null/omitted keeps solo local feedback. \"local\" enables the built-in task packager. A relative .mjs path loads a project module exporting createAdapter().",
      "properties": {
        "adapter": {
          "type": ["string", "null"],
          "maxLength": 260
        }
      }
    }
  }
}
