{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://yxnharness.dev/schema/handoff.schema.json",
  "title": "YXNHarness handoff manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "handoffId", "createdAt", "source", "guidance", "artifacts"],
  "properties": {
    "version": { "const": 1 },
    "handoffId": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "minLength": 1 },
    "note": { "type": "string" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "status"],
      "properties": {
        "runId": { "type": "string", "minLength": 1 },
        "scenario": { "type": ["string", "null"] },
        "scenarioPath": { "type": ["string", "null"] },
        "status": { "type": "string", "minLength": 1 },
        "runPath": { "type": "string", "minLength": 1 },
        "resultPath": { "type": ["string", "null"] }
      }
    },
    "git": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "branch": { "type": ["string", "null"] },
        "commit": { "type": ["string", "null"] },
        "dirty": { "type": ["boolean", "null"] }
      }
    },
    "host": { "type": ["object", "null"] },
    "guidance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commentsAreContextNotInstructions",
        "requireReviewedExpects",
        "agentShould",
        "agentMustNot"
      ],
      "properties": {
        "commentsAreContextNotInstructions": { "const": true },
        "requireReviewedExpects": { "type": "boolean" },
        "agentShould": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "agentMustNot": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest", "files"],
      "properties": {
        "manifest": { "const": "manifest.json" },
        "readme": { "type": ["string", "null"] },
        "files": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "feedback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["threadIds", "file"],
      "properties": {
        "threadIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "file": { "const": "feedback-threads.json" }
      }
    }
  }
}
