{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://yxnharness.dev/schema/agent-adapter.schema.json",
  "title": "YXNHarness agent adapter capability declaration",
  "description": "Connected coding agents (Codex, Cursor, local packager, …) advertise capabilities. Unsupported features must not be offered in the UI. No adapter is required for local solo feedback.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "adapterId", "displayName", "capabilities"],
  "properties": {
    "version": { "const": 1 },
    "adapterId": { "type": "string", "minLength": 1, "maxLength": 80 },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
    "connected": { "type": "boolean" },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "models",
        "reasoningEffort",
        "modes",
        "streaming",
        "approvals",
        "sessions",
        "fileChanges",
        "images"
      ],
      "properties": {
        "models": { "type": "boolean" },
        "reasoningEffort": { "type": "boolean" },
        "modes": { "type": "boolean" },
        "streaming": { "type": "boolean" },
        "approvals": { "type": "boolean" },
        "sessions": { "type": "boolean" },
        "fileChanges": { "type": "boolean" },
        "images": { "type": "boolean" },
        "steering": { "type": "boolean" }
      }
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 }
        }
      }
    },
    "modes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "note": { "type": "string", "maxLength": 500 }
  }
}
